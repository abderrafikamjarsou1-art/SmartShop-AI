generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String              @id @db.Uuid
  email            String              @unique
  fullName         String?
  avatarUrl        String?
  isSuperAdmin     Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  aiConversations  AiConversation[]
  auditLogs        AuditLog[]
  customerPayments CustomerPayment[]
  expenses         Expense[]
  movements        InventoryMovement[]
  notifications    Notification[]
  purchaseReceipts PurchaseReceipt[]
  purchases        Purchase[]
  sales            Sale[]
  memberships      UserBusiness[]

  @@map("users")
}

model Business {
  id               String              @id @default(uuid()) @db.Uuid
  name             String
  logoUrl          String?
  currency         String              @default("MAD")
  language         String              @default("en")
  timezone         String              @default("Africa/Casablanca")
  taxRate          Decimal             @default(0) @db.Decimal(5, 2)
  address          String?
  phone            String?
  email            String?
  allowOverselling Boolean             @default(false)
  suspendedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?
  aiConversations  AiConversation[]
  auditLogs        AuditLog[]
  categories       Category[]
  customerPayments CustomerPayment[]
  customers        Customer[]
  expenses         Expense[]
  movements        InventoryMovement[]
  invoices         Invoice[]
  notifications    Notification[]
  products         Product[]
  receipts         PurchaseReceipt[]
  purchases        Purchase[]
  sales            Sale[]
  subscription     Subscription?
  suppliers        Supplier[]
  usageCounters    UsageCounter[]
  members          UserBusiness[]

  @@map("businesses")
}

model UserBusiness {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  businessId String   @db.Uuid
  role       UserRole @default(CASHIER)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("user_businesses")
}

model Customer {
  id                 String            @id @default(uuid()) @db.Uuid
  businessId         String            @db.Uuid
  name               String
  email              String?
  phone              String?
  address            String?
  notes              String?
  tags               String[]          @default([])
  storeCredit        Decimal           @default(0) @db.Decimal(12, 2)
  outstandingBalance Decimal           @default(0) @db.Decimal(12, 2)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?
  payments           CustomerPayment[]
  business           Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales              Sale[]

  @@index([businessId])
  @@index([businessId, name])
  @@index([businessId, phone])
  @@map("customers")
}

model Supplier {
  id            String     @id @default(uuid()) @db.Uuid
  businessId    String     @db.Uuid
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?
  expenses      Expense[]
  products      Product[]
  purchases     Purchase[]
  business      Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, name])
  @@map("suppliers")
}

model Category {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @db.Uuid
  name       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([businessId, name])
  @@index([businessId])
  @@map("categories")
}

model Product {
  id            String              @id @default(uuid()) @db.Uuid
  businessId    String              @db.Uuid
  categoryId    String?             @db.Uuid
  supplierId    String?             @db.Uuid
  name          String
  barcode       String?
  sku           String?
  buyingPrice   Decimal             @db.Decimal(12, 2)
  sellingPrice  Decimal             @db.Decimal(12, 2)
  quantity      Int                 @default(0)
  minimumStock  Int                 @default(0)
  status        ProductStatus       @default(ACTIVE)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?
  movements     InventoryMovement[]
  images        ProductImage[]
  business      Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category      Category?           @relation(fields: [categoryId], references: [id])
  supplier      Supplier?           @relation(fields: [supplierId], references: [id])
  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId])
  @@index([businessId, name])
  @@index([businessId, status])
  @@index([categoryId])
  @@index([supplierId])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  url       String
  path      String
  isPrimary Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model InventoryMovement {
  id             String            @id @default(uuid()) @db.Uuid
  businessId     String            @db.Uuid
  productId      String            @db.Uuid
  userId         String?           @db.Uuid
  type           StockMovementType
  quantity       Int
  quantityBefore Int
  quantityAfter  Int
  reason         String?
  saleId         String?           @db.Uuid
  purchaseId     String?           @db.Uuid
  createdAt      DateTime          @default(now())
  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchase       Purchase?         @relation(fields: [purchaseId], references: [id])
  sale           Sale?             @relation(fields: [saleId], references: [id])
  user           User?             @relation(fields: [userId], references: [id])

  @@index([businessId, createdAt])
  @@index([businessId, type, createdAt])
  @@index([productId, createdAt])
  @@map("inventory_movements")
}

model Sale {
  id             String              @id @default(uuid()) @db.Uuid
  businessId     String              @db.Uuid
  customerId     String?             @db.Uuid
  userId         String?             @db.Uuid
  saleNumber     Int
  clientRef      String?             @db.Uuid
  status         SaleStatus          @default(COMPLETED)
  paymentStatus  PaymentStatus       @default(PAID)
  subtotal       Decimal             @db.Decimal(12, 2)
  discountAmount Decimal             @default(0) @db.Decimal(12, 2)
  taxRate        Decimal             @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal             @default(0) @db.Decimal(12, 2)
  total          Decimal             @db.Decimal(12, 2)
  amountPaid     Decimal             @default(0) @db.Decimal(12, 2)
  notes          String?
  voidedAt       DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  movements      InventoryMovement[]
  invoice        Invoice?
  items          SaleItem[]
  payments       SalePayment[]
  business       Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer       Customer?           @relation(fields: [customerId], references: [id])
  user           User?               @relation(fields: [userId], references: [id])

  @@unique([businessId, saleNumber])
  @@unique([businessId, clientRef])
  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id               String   @id @default(uuid()) @db.Uuid
  saleId           String   @db.Uuid
  productId        String   @db.Uuid
  quantity         Int
  returnedQuantity Int      @default(0)
  unitPrice        Decimal  @db.Decimal(12, 2)
  unitCost         Decimal  @db.Decimal(12, 2)
  discountAmount   Decimal  @default(0) @db.Decimal(12, 2)
  total            Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  product          Product  @relation(fields: [productId], references: [id])
  sale             Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model SalePayment {
  id        String        @id @default(uuid()) @db.Uuid
  saleId    String        @db.Uuid
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  reference String?
  createdAt DateTime      @default(now())
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([method, createdAt])
  @@index([createdAt])
  @@map("sale_payments")
}

model Invoice {
  id            String    @id @default(uuid()) @db.Uuid
  businessId    String    @db.Uuid
  saleId        String    @unique @db.Uuid
  invoiceNumber Int
  pdfUrl        String?
  issuedAt      DateTime  @default(now())
  dueDate       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sale          Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@unique([businessId, invoiceNumber])
  @@index([businessId, issuedAt])
  @@map("invoices")
}

model Purchase {
  id             String              @id @default(uuid()) @db.Uuid
  businessId     String              @db.Uuid
  supplierId     String?             @db.Uuid
  userId         String?             @db.Uuid
  purchaseNumber Int
  status         PurchaseStatus      @default(DRAFT)
  paymentStatus  PaymentStatus       @default(PENDING)
  subtotal       Decimal             @db.Decimal(12, 2)
  taxAmount      Decimal             @default(0) @db.Decimal(12, 2)
  total          Decimal             @db.Decimal(12, 2)
  sentAt         DateTime?
  expectedAt     DateTime?
  receivedAt     DateTime?
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  movements      InventoryMovement[]
  items          PurchaseItem[]
  receipts       PurchaseReceipt[]
  business       Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier       Supplier?           @relation(fields: [supplierId], references: [id])
  user           User?               @relation(fields: [userId], references: [id])

  @@unique([businessId, purchaseNumber])
  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([supplierId])
  @@map("purchases")
}

model PurchaseItem {
  id               String   @id @default(uuid()) @db.Uuid
  purchaseId       String   @db.Uuid
  productId        String   @db.Uuid
  quantity         Int
  receivedQuantity Int      @default(0)
  returnedQuantity Int      @default(0)
  unitCost         Decimal  @db.Decimal(12, 2)
  total            Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  product          Product  @relation(fields: [productId], references: [id])
  purchase         Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model PurchaseReceipt {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  purchaseId String   @db.Uuid
  userId     String?  @db.Uuid
  clientRef  String   @db.Uuid
  /// * [{ purchaseItemId, quantity }] received in THIS event
  lines      Json
  notes      String?
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@unique([businessId, clientRef])
  @@index([purchaseId])
  @@map("purchase_receipts")
}

model Expense {
  id                 String              @id @default(uuid()) @db.Uuid
  businessId         String              @db.Uuid
  supplierId         String?             @db.Uuid
  userId             String?             @db.Uuid
  category           ExpenseCategory     @default(OTHER)
  title              String
  amount             Decimal             @db.Decimal(12, 2)
  taxAmount          Decimal             @default(0) @db.Decimal(12, 2)
  paymentMethod      PaymentMethod?
  date               DateTime            @default(now())
  notes              String?
  receiptUrl         String?
  /// * [{ url, path, name, mimeType }] — receipt images and PDFs
  attachments        Json                @default("[]")
  isRecurring        Boolean             @default(false)
  recurrenceInterval RecurrenceInterval?
  nextOccurrence     DateTime?
  templateId         String?             @db.Uuid
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier           Supplier?           @relation(fields: [supplierId], references: [id])
  user               User?               @relation(fields: [userId], references: [id])

  @@index([businessId, date])
  @@index([businessId, category])
  @@index([businessId, supplierId])
  @@index([businessId, isRecurring, nextOccurrence])
  @@map("expenses")
}

model CustomerPayment {
  id          String        @id @default(uuid()) @db.Uuid
  businessId  String        @db.Uuid
  customerId  String        @db.Uuid
  userId      String?       @db.Uuid
  method      PaymentMethod
  amount      Decimal       @db.Decimal(12, 2)
  /// * [{ saleId, saleNumber, amount }] — how the money was applied
  allocations Json
  reference   String?
  notes       String?
  createdAt   DateTime      @default(now())
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user        User?         @relation(fields: [userId], references: [id])

  @@index([businessId, createdAt])
  @@index([customerId, createdAt])
  @@map("customer_payments")
}

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  businessId String           @db.Uuid
  userId     String?          @db.Uuid
  type       NotificationType
  title      String
  message    String
  link       String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId, userId, readAt])
  @@index([businessId, createdAt])
  @@map("notifications")
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  businessId           String             @unique @db.Uuid
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  interval             BillingInterval    @default(MONTHLY)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  trialEndsAt          DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  business             Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("subscriptions")
}

model WebhookEvent {
  id            String   @id @default(uuid()) @db.Uuid
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())

  @@index([type, processedAt])
  @@map("webhook_events")
}

model UsageCounter {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  metric     String
  period     String
  value      BigInt   @default(0)
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, metric, period])
  @@map("usage_counters")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  userId     String?  @db.Uuid
  action     String
  entity     String
  entityId   String?  @db.Uuid
  metadata   Json?
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([businessId, createdAt])
  @@index([businessId, entity, entityId])
  @@map("audit_logs")
}

model AiConversation {
  id         String      @id @default(uuid()) @db.Uuid
  businessId String      @db.Uuid
  userId     String      @db.Uuid
  title      String      @default("New conversation")
  /// * Rolling summary of older turns — keeps context small on long chats
  summary    String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   AiMessage[]

  @@index([businessId, userId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(uuid()) @db.Uuid
  conversationId String         @db.Uuid
  role           AiRole
  content        String
  /// * [{ tool, args, ms }] — which tools the assistant called
  toolCalls      Json?
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  CASHIER
  EMPLOYEE
}

enum SubscriptionPlan {
  FREE
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum SaleStatus {
  DRAFT
  COMPLETED
  PARTIALLY_RETURNED
  RETURNED
  VOIDED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  REFUNDED
  FAILED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  STORE_CREDIT
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARIES
  MARKETING
  SUPPLIES
  TRANSPORT
  MAINTENANCE
  TAXES
  INSURANCE
  OTHER
}

enum RecurrenceInterval {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum StockMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  INITIAL
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum NotificationType {
  LOW_STOCK
  SALE
  PAYMENT
  SUBSCRIPTION
  SYSTEM
}

enum AiRole {
  USER
  ASSISTANT
}
